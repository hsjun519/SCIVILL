# Set in Vercel Project Settings -> Environment Variables; never commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=public-web-config-value
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=public-web-app-id
# Verified Google account matching this email may bootstrap administration.
ADMIN_EMAIL=your-confirmed-admin-email@example.com
# Optional: read-only competition feed during migration; migrate later to Postgres.
LEGACY_COMPETITIONS_URL=https://scvill-club-hub.softbrook129.chatgpt.site/api/competitions
